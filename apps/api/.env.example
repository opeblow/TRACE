# Copy to .env and use a secret manager for keys.
TRACE_ENV=development
TATUM_MAINNET_API_KEY=
TATUM_GRPC_TARGET=sui-mainnet-grpc.gateway.tatum.io:443
REDIS_URL=
# Walrus Memory (server-side only; never expose to the browser)
WALRUS_MEMORY_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE_PREFIX=trace-dev
ANALYSIS_RATE_LIMIT=10
ANALYSIS_RATE_WINDOW_SECONDS=60
BACKEND_CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,*.onrender.com
